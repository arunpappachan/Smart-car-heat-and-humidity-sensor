# ==============================================================================
# Environment Configuration - Smart Car Heat and Humidity Detector
# ==============================================================================

# Application Port
PORT=3000

# PostgreSQL Database Credentials
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_car_iot
DB_USER=smart_car_user
DB_PASSWORD=smart_car_pass_2026
# Optional direct connection string (e.g. for Render or Neon cloud Postgres)
# DATABASE_URL=postgres://user:password@host:5432/smart_car_iot?sslmode=require

# Device Ingestion Security
DEVICE_API_KEY=smart-car-secret-key-2026

# Temperature Indication Thresholds (°C)
TEMP_NORMAL_THRESHOLD=30.0
TEMP_HIGH_THRESHOLD=35.0

# Telemetry Liveness Timeout (Seconds before status becomes 'SENSOR OFFLINE')
OFFLINE_TIMEOUT_SECONDS=20

# Development / College Demo Simulation Mode (true/false)
ENABLE_SIMULATION=true

# CORS Allowed Origins (Comma-separated or '*')
CORS_ORIGIN=*
